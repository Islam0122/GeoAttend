# Example HTTPS termination in the web container.
# 1) Mount certificates:   volumes: ["./certs:/etc/nginx/certs:ro"]   and publish port 443.
# 2) Copy this file into the image as /etc/nginx/conf.d/tls.conf and change server_name.
# 3) Copy the `location` blocks from frontend/nginx.conf into the 443 server below.
# Browser geolocation ONLY works over HTTPS (or http://localhost).
server {
  listen 443 ssl;
  http2 on;
  server_name attendance.example.com;
  ssl_certificate     /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  root /usr/share/nginx/html;
  # ... locations from frontend/nginx.conf ...
}
server { listen 80; server_name attendance.example.com; return 301 https://$host$request_uri; }
