# ======================= GeoAttend configuration =======================
# Copy to .env and change every value marked REQUIRED. Backend settings use the GEOATTEND_ prefix.

# --- Database (docker compose builds GEOATTEND_DATABASE_URL from these) ---
POSTGRES_USER=geoattend
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=geoattend

# --- Security (REQUIRED: generate with  python -c "import secrets;print(secrets.token_urlsafe(48))") ---
GEOATTEND_SECRET_KEY=change-me-to-a-long-random-value
GEOATTEND_ENVIRONMENT=production
GEOATTEND_ACCESS_TOKEN_MINUTES=30
GEOATTEND_REFRESH_TOKEN_DAYS=30
# true behind HTTPS (required in production so the refresh cookie is Secure)
GEOATTEND_COOKIE_SECURE=true
GEOATTEND_COOKIE_SAMESITE=strict
GEOATTEND_INVITE_TOKEN_HOURS=72

# --- Public URL / CORS ---
GEOATTEND_FRONTEND_URL=https://attendance.example.com
GEOATTEND_CORS_ORIGINS=["https://attendance.example.com"]

# --- Google Sign-In (optional). OAuth "Web application" client; authorised redirect URI:
#     https://<your-domain>/auth/google/callback   (same client id for backend and frontend)
GEOATTEND_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Rate limiting (count/seconds); Redis-backed in docker compose ---
GEOATTEND_RATE_LIMIT_ENABLED=true
GEOATTEND_RATE_LIMIT_AUTH=10/60
GEOATTEND_RATE_LIMIT_LOCATIONS=120/60
GEOATTEND_RATE_LIMIT_DEFAULT=600/60

# --- E-mail (optional; without SMTP notifications are in-app only and HR copies invite links) ---
GEOATTEND_SMTP_HOST=
GEOATTEND_SMTP_PORT=587
GEOATTEND_SMTP_USER=
GEOATTEND_SMTP_PASSWORD=
GEOATTEND_SMTP_FROM=no-reply@example.com
GEOATTEND_SMTP_TLS=true

# --- Map tiles (optional). Default: public OpenStreetMap tiles (free, attribution, fair-use policy).
#     For heavy use point this at your own or a commercial OSM tile server.
VITE_MAP_TILES=

# --- Runtime ---
GEOATTEND_LOG_LEVEL=INFO
GEOATTEND_LOG_JSON=true
GEOATTEND_MAX_CLOCK_SKEW_SECONDS=120
HTTP_PORT=80
WEB_CONCURRENCY=4
CELERY_CONCURRENCY=2
